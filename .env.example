NODE_ENV=development

PORT=3000

API_PREFIX=/api/v1

DATABASE_URL="mysql://user:password@localhost:3306/ora_de_nuit"

JWT_SECRET=replace_with_a_long_random_string

JWT_EXPIRES_IN=1d

CORS_ORIGIN=http://localhost:3000

LOG_LEVEL=info

CACHE_TTL_SECONDS=300

UPLOAD_DIR=src/uploads

MAX_FILE_SIZE_BYTES=5242880

# Stripe test-mode keys — get these from https://dashboard.stripe.com/test/apikeys
# and `stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe`
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Deep link the mobile app registers (app.json "scheme") for Stripe Checkout to
# redirect back into after payment.
ORDER_CHECKOUT_RETURN_SCHEME=reservationapp://checkout-complete

# Path to the Firebase Admin SDK service account JSON (generate from Firebase
# console > Project Settings > Service Accounts). Never commit this file —
# copy it directly onto the server it needs to run on.
FIREBASE_SERVICE_ACCOUNT_PATH=/root/reservation-app/src/config/firebase-service-account.json

# SMTP settings for outgoing transactional email (reservation/order
# confirmations, cancellations). IONOS mailbox example below.
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_mailbox_address
SMTP_PASSWORD=replace_with_mailbox_password
EMAIL_FROM_NAME=Ora de Nuit
